# ---- Supabase ----------------------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Grants full RLS bypass.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Judge -------------------------------------------------------------------
# judge0 | piston
#
# The spec locked Piston, but the public Piston endpoint went whitelist-only on
# 2026-02-15 and now refuses /execute. Judge0's free public CE instance needs no
# key, runs every language in lib/judge/languages.ts, and reports peak memory.
# Both runners implement the same CodeRunner interface, so this is a one-line
# switch either way.
JUDGE_PROVIDER=judge0

# Free public instance. Swap for your own to lift the rate limit.
JUDGE0_URL=https://ce.judge0.com
# Only needed for a self-hosted instance with auth enabled.
JUDGE0_TOKEN=

# Used when JUDGE_PROVIDER=piston. Point at a self-hosted Piston
# (see docker-compose.piston.yml); the public URL below is whitelist-only.
PISTON_URL=https://emkc.org/api/v2/piston

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
